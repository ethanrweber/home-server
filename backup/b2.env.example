# template for /etc/restic/b2.env, the settings of restic-backup.service.
# README.md shows how to install it. the values are in bitwarden

# path to the stack checkout
STACK_DIR=/path/to/home-server

# the endpoint and the bucket are in the notes of the bitwarden entry "B2 app key — restic"
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>

# the part of the endpoint after "s3.", for example us-east-005
AWS_DEFAULT_REGION=<region>

# the keyID and the applicationKey, from the same entry
AWS_ACCESS_KEY_ID=<keyID>
AWS_SECRET_ACCESS_KEY=<applicationKey>

# a file that contains only the password from the entry "restic repo password — b2"
RESTIC_PASSWORD_FILE=/etc/restic/b2.pass

# the healthchecks.io ping url for this backup
HC_URL=https://hc-ping.com/<uuid>
