# copy to /etc/restic/b2.env, fill in from Bitwarden, then: sudo chmod 600 /etc/restic/b2.env

# where the stack's checkout is
STACK_DIR=/path/to/home-server

# endpoint and bucket: the notes of the Bitwarden entry "B2 app key — restic"
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>
# the part of the endpoint after "s3.", e.g. us-east-005
AWS_DEFAULT_REGION=<region>
# keyID and applicationKey from the same entry
AWS_ACCESS_KEY_ID=<keyID>
AWS_SECRET_ACCESS_KEY=<applicationKey>
# a file holding only the password from "restic repo password — b2" (also chmod 600)
RESTIC_PASSWORD_FILE=/etc/restic/b2.pass

# the healthchecks.io ping URL for this backup
HC_URL=https://hc-ping.com/<uuid>
