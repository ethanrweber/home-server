# /etc/restic/b2.env: the Backblaze B2 repository. Copy it there and fill it in from
# Bitwarden, then lock it down:  sudo chmod 600 /etc/restic/b2.env
# Format: KEY=VALUE, quotes optional, no variable expansion.

# endpoint and bucket name: the notes of the Bitwarden entry "B2 app key — restic"
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>
AWS_DEFAULT_REGION=<region, the part of the endpoint after "s3.", e.g. us-east-005>

# keyID and applicationKey from the same Bitwarden entry
AWS_ACCESS_KEY_ID=<keyID>
AWS_SECRET_ACCESS_KEY=<applicationKey>

# the repository password, from the Bitwarden entry "restic repo password — b2", goes in
# this file on its own line:  sudo install -m 600 /dev/null /etc/restic/b2.pass, then edit
RESTIC_PASSWORD_FILE=/etc/restic/b2.pass

# which sets from sets/sets.conf this repository receives
SETS="stack appzips media"

# healthchecks.io ping URLs (optional; leave empty until the checks exist)
HC_BACKUP_URL=
HC_MAINT_URL=
