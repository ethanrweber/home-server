[Unit]
Description=restic backup of the stack
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# the repository, its keys and password file, the healthchecks URL, and STACK_DIR
EnvironmentFile=/etc/restic/b2.env
# root services get no $HOME, and restic needs somewhere for its cache
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/bin/bash ${STACK_DIR}/backup/backup.sh
# if the backup failed or hung partway, start the stack again anyway
ExecStopPost=/usr/bin/docker compose -f ${STACK_DIR}/docker-compose.yml start
TimeoutStartSec=2h
