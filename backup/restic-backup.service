[Unit]
Description=restic backup of the stack
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# the repository settings, HC_URL and STACK_DIR
EnvironmentFile=/etc/restic/b2.env
# systemd sets no $HOME for system services, and restic needs a cache directory
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/bin/bash ${STACK_DIR}/backup/backup.sh
# runs even if the script fails or times out, so the stack always comes back up
ExecStopPost=/usr/bin/docker compose -f ${STACK_DIR}/docker-compose.yml start
TimeoutStartSec=2h
